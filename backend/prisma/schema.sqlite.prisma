// SmartQ AI - LOCAL DEVELOPMENT SCHEMA (SQLite)
// To use locally: npm run db:use-sqlite
// Then set DATABASE_URL="file:./smartq.db" in backend/.env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("USER")
  language     String   @default("en")
  isActive     Boolean  @default(true)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tokens        Token[]
  appointments  Appointment[]
  visitHistory  VisitHistory[]
  notifications Notification[]
  staffProfile  Staff?

  @@map("users")
}

model Sector {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  organizations Organization[]

  @@map("sectors")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  shortName   String?
  sectorId    String
  address     String
  city        String   @default("Chennai")
  state       String   @default("Tamil Nadu")
  pincode     String?
  phone       String?
  email       String?
  website     String?
  latitude    Float    @default(13.0827)
  longitude   Float    @default(80.2707)
  description String?
  isDemo      Boolean  @default(false)
  isActive    Boolean  @default(true)
  openTime    String   @default("09:00")
  closeTime   String   @default("17:00")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sector      Sector       @relation(fields: [sectorId], references: [id])
  departments Department[]
  staff       Staff[]

  @@map("organizations")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  services     Service[]
  counters     Counter[]

  @@map("departments")
}

model Service {
  id                  String   @id @default(uuid())
  departmentId        String
  name                String
  description         String?
  avgServiceTime      Int      @default(5)
  maxTokensPerDay     Int      @default(200)
  requiresAppointment Boolean  @default(false)
  fee                 Float?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  department   Department       @relation(fields: [departmentId], references: [id])
  counters     CounterService[]
  tokens       Token[]
  appointments Appointment[]

  @@map("services")
}

model Counter {
  id           String   @id @default(uuid())
  departmentId String
  name         String
  number       Int
  status       String   @default("CLOSED")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department       @relation(fields: [departmentId], references: [id])
  staff      Staff[]
  services   CounterService[]
  tokens     Token[]

  @@map("counters")
}

model CounterService {
  counterId String
  serviceId String

  counter Counter @relation(fields: [counterId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@id([counterId, serviceId])
  @@map("counter_services")
}

model Staff {
  id             String   @id @default(uuid())
  userId         String   @unique
  organizationId String
  counterId      String?
  employeeId     String?
  designation    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  counter      Counter?     @relation(fields: [counterId], references: [id])

  @@map("staff")
}

model Queue {
  id           String   @id @default(uuid())
  departmentId String   @unique
  date         DateTime @default(now())
  tokenPrefix  String   @default("A")
  lastNumber   Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tokens Token[]

  @@map("queues")
}

model Token {
  id            String   @id @default(uuid())
  queueId       String
  userId        String?
  serviceId     String
  counterId     String?
  tokenNumber   String
  status        String   @default("WAITING")
  position      Int
  isFollowUp    Boolean  @default(false)
  prevVisitDate DateTime?
  notes         String?
  bookedAt      DateTime @default(now())
  calledAt      DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  estimatedWait Int?
  actualWait    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  queue   Queue    @relation(fields: [queueId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  service Service  @relation(fields: [serviceId], references: [id])
  counter Counter? @relation(fields: [counterId], references: [id])

  @@map("tokens")
}

model Appointment {
  id            String   @id @default(uuid())
  userId        String
  serviceId     String
  scheduledDate DateTime
  scheduledTime String
  status        String   @default("BOOKED")
  tokenNumber   String?
  notes         String?
  isFollowUp    Boolean  @default(false)
  prevVisitDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@map("appointments")
}

model VisitHistory {
  id               String   @id @default(uuid())
  userId           String
  tokenId          String?
  appointmentId    String?
  organizationName String
  serviceName      String
  visitDate        DateTime
  status           String
  waitTime         Int?
  notes            String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("visit_history")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model QueueEvent {
  id          String   @id @default(uuid())
  queueId     String?
  tokenId     String?
  counterId   String?
  eventType   String
  data        String?
  triggeredBy String?
  createdAt   DateTime @default(now())

  @@map("queue_events")
}

model Prediction {
  id             String   @id @default(uuid())
  queueId        String
  estimatedWait  Int
  crowdLevel     String
  confidence     Float
  activeCounters Int
  waitingCount   Int
  avgServiceTime Float
  noShowRate     Float
  recommendation String?
  createdAt      DateTime @default(now())

  @@map("predictions")
}

model Recommendation {
  id          String    @id @default(uuid())
  queueId     String
  message     String
  action      String
  expectedETA Int?
  currentETA  Int?
  isAccepted  Boolean   @default(false)
  acceptedBy  String?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("recommendations")
}

model CanteenOrg {
  id              String   @id @default(uuid())
  organizationId  String   @unique
  name            String
  isOpen          Boolean  @default(true)
  openTime        String   @default("07:00")
  closeTime       String   @default("21:00")
  lastOrderNumber Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  counters CanteenCounter[]
  orders   CanteenOrder[]

  @@map("canteen_orgs")
}

model CanteenCounter {
  id           String   @id @default(uuid())
  canteenOrgId String
  name         String
  type         String
  number       Int
  status       String   @default("OPEN")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  canteenOrg  CanteenOrg         @relation(fields: [canteenOrgId], references: [id])
  menuItems   MenuItem[]
  orderItems  CanteenOrderItem[]

  @@map("canteen_counters")
}

model MenuItem {
  id               String   @id @default(uuid())
  canteenCounterId String
  name             String
  description      String?
  price            Float    @default(0)
  category         String   @default("GENERAL")
  mealPeriod       String   @default("ALL")
  avgPrepTime      Int      @default(5)
  availability     String   @default("AVAILABLE")
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  counter    CanteenCounter    @relation(fields: [canteenCounterId], references: [id])
  orderItems CanteenOrderItem[]

  @@map("menu_items")
}

model CanteenOrder {
  id                 String   @id @default(uuid())
  canteenOrgId       String
  userId             String?
  guestName          String?
  orderNumber        String
  status             String   @default("PLACED")
  totalAmount        Float    @default(0)
  notes              String?
  estimatedReadyTime Int?
  actualReadyTime    Int?
  placedAt           DateTime @default(now())
  confirmedAt        DateTime?
  prepStartAt        DateTime?
  readyAt            DateTime?
  collectedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  canteenOrg CanteenOrg         @relation(fields: [canteenOrgId], references: [id])
  items      CanteenOrderItem[]

  @@map("canteen_orders")
}

model CanteenOrderItem {
  id               String   @id @default(uuid())
  orderId          String
  menuItemId       String
  canteenCounterId String
  name             String
  price            Float
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())

  order   CanteenOrder   @relation(fields: [orderId], references: [id])
  item    MenuItem       @relation(fields: [menuItemId], references: [id])
  counter CanteenCounter @relation(fields: [canteenCounterId], references: [id])

  @@map("canteen_order_items")
}
