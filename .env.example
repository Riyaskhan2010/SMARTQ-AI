# ============================================================
# SmartQ AI - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/smartq_ai"

# --- JWT ---
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8000

# --- Maps (Optional - demo mode works without this) ---
MAPS_API_KEY=""
MAPS_PROVIDER="openstreetmap"

# --- Firebase (Optional - in-app notifications work without this) ---
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_WEB_API_KEY=""

# --- Demo Mode ---
DEMO_MODE=true
